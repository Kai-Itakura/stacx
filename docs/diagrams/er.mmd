erDiagram
  users ||--o{ user_identities : "has"
  users ||--o{ sessions : "has"
  users ||--o{ projects : "owns"
  users ||--o{ tags : "owns"
  users ||--o{ stars : "owns"
  projects ||--o{ stars : "contains"
  stars ||--o{ star_tags : "tagged by"
  tags ||--o{ star_tags : "applied to"

  users {
    text id PK
    integer created_at
    integer updated_at
    integer last_login_at
  }

  user_identities {
    text id PK
    text user_id FK "users.id cascade"
    text provider UK "UQ(provider, provider_sub)"
    text provider_sub UK "UQ(provider, provider_sub)"
    text email "NULL 可"
    integer email_verified "boolean, default false"
    text name "NULL 可"
    text picture_url "NULL 可"
    integer created_at
    integer updated_at
  }

  sessions {
    text id PK
    text user_id FK "users.id cascade"
    integer expires_at
    integer created_at
    text user_agent "NULL 可"
    text ip_address "NULL 可"
  }

  projects {
    text id PK
    text user_id FK "users.id cascade"
    text name
    integer start_date
    integer end_date "NULL なら進行中"
    text summary "NULL 可"
    integer team_size "NULL 可"
    text role "NULL 可"
    text work_style "NULL 可"
    text tech_stack "JSON 配列, default '[]'"
    integer created_at
    integer updated_at
  }

  tags {
    text id PK
    text user_id FK,UK "users.id cascade / UQ(user_id, name)"
    text name UK "UQ(user_id, name)"
    integer created_at
  }

  stars {
    text id PK
    text user_id FK "users.id cascade"
    text project_id FK "projects.id cascade"
    text situation "NULL 可"
    text task "NULL 可"
    text action "NULL 可"
    text result "NULL 可"
    text notes "NULL 可 / 作業ログ"
    integer created_at
    integer updated_at
  }

  star_tags {
    text star_id PK,FK "stars.id cascade"
    text tag_id PK,FK "tags.id cascade"
  }
